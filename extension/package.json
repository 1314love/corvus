{
  "name": "corvus-extension",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Corvus browser bridge extension: MV3, Vue 3 UI, typed service worker.",
  "scripts": {
    "dev": "vite --config vite.ui.config.ts",
    "clean": "node scripts/clean.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:background": "vite build --config vite.background.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "build:ui": "vite build --config vite.ui.config.ts",
    "build:manifest": "node scripts/copy-manifest.mjs",
    "build": "pnpm clean && pnpm build:background && pnpm build:content && pnpm build:ui && pnpm build:manifest && pnpm check-build",
    "generate:contracts": "node scripts/generate-tool-contracts.mjs",
    "check-build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@pinia/testing": "^1.0.1",
    "@playwright/test": "^1.51.0",
    "@types/chrome": "^0.0.315",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.8",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "happy-dom": "^17.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.8",
    "vue-tsc": "^2.2.4"
  }
}
