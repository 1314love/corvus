{
  "manifest_version": 3,
  "name": "Corvus",
  "version": "1.4.0",
  "description": "Local bridge between the Corvus daemon and this browser.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "debugger",
    "webRequest",
    "downloads",
    "alarms",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Corvus",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
